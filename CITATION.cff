    family-names: Chai
  - given-names: Kabilar
    family-names: Gunalan
repository-code: "https://github.com/lincbrain/linc-convert"
url: "https://convert.lincbrain.org"
license: Apache-2.0
keywords:
  - LINC
  - neuroimaging
  - microscopy
  - data conversion
  - OME-Zarr
  - NIfTI-Zarr
  - Zarr
